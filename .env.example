# SQLite local database
DATABASE_URL="file:./dev.db"

# Used to sign session JWTs. Generate something long and random.
AUTH_SECRET="change-me-to-a-long-random-string"

# The single admin email. Whoever signs up with this email gets admin access.
ADMIN_EMAIL="admin@wrong.local"

# Optional: admin-only current-events question drafts. Keep this server-only.
OPENAI_API_KEY=""
# Optional model override; must support Responses web search and structured outputs.
OPENAI_QUESTION_MODEL="gpt-5.4-mini"
